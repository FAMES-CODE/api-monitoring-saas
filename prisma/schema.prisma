// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MonitorStatus {
  UNKNOWN
  UP
  DOWN
}

enum CheckStatus {
  SUCCESS
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  username String? @unique
  password String?

  accounts Account[]
  sessions Session[]
  monitors Monitor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Monitor {
  id             String        @id @default(uuid())
  userId         String
  name           String        @db.VarChar(255)
  url            String        @db.VarChar(255)
  method         String        @db.VarChar(255)
  headers        Json?
  body           Json?
  interval       Int
  expectedStatus Int
  timeout        Int           @default(30000)
  enabled        Boolean       @default(true)
  status         MonitorStatus @default(UNKNOWN)
  createdAt      DateTime      @default(now()) @db.Timestamp(3)
  updatedAt      DateTime      @updatedAt @db.Timestamp(3)
  user           User          @relation(fields: [userId], references: [id])
  checks         Check[]
  incidents      Incident[]

  @@index([userId])
}

model Check {
  id           String      @id @default(uuid())
  monitorId    String
  status       CheckStatus
  statusCode   Int?
  responseTime Int
  error        String?     @db.VarChar(255)
  checkedAt    DateTime    @default(now()) @db.Timestamp(3)
  monitor      Monitor     @relation(fields: [monitorId], references: [id])

  @@index([monitorId])
}

model Incident {
  id         String   @id @default(uuid())
  monitorId  String
  startedAt  DateTime @default(now()) @db.Timestamp(3)
  resolvedAt DateTime @db.Timestamp(3)
  reason     String   @default("Unknown") @db.VarChar(255)
  status     String   @default("open") @db.VarChar(255)
  monitor    Monitor  @relation(fields: [monitorId], references: [id])

  @@index([monitorId])
}
